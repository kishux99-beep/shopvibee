generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  categories String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DealInteraction {
  id        String   @id @default(cuid())
  dealId    Int
  action    String
  createdAt DateTime @default(now())
}

// 🚀 Updated Deal Model for Rich Content & Amazon Compliance
model Deal {
  id            Int      @id @default(autoincrement())
  title         String
  category      String
  price         String
  originalPrice String?
  discount      String?  
  store         String?  
  image         String?  
  images        String[] // Array of image URLs for slider
  description   String?  // Product description or summary
  features      String[] // Array of bullet points/highlights
  link          String
  
  // 💡 AI Rich Content Fields (To prevent "Thin Content" rejection)
  whyBuy        String?
  deepReview    String?
  expertTips    String?
  verdict       String?
  bestFor       String?

  createdAt     DateTime @default(now())
}

// ⭐Real User Review⭐
model Review {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("ShopVibee Shopper")
  rating    Int      @default(5)
  comment   String
  ipHash    String   @unique // Yeh ensure karega ki ek hi user/device se sirf ek review aaye
  createdAt DateTime @default(now())
}