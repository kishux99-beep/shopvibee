generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  categories String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DealInteraction {
  id        String   @id @default(cuid())
  dealId    Int
  action    String
  createdAt DateTime @default(now())
}

// 🚀 Naya Deal Model Admin Panel ke liye
model Deal {
  id            Int      @id @default(autoincrement())
  title         String
  category      String
  price         String
  originalPrice String?
  discount      String?   // ? lagane se yeh optional ho jayega
  store         String?   // ? lagane se yeh optional ho jayega
  image         String?   // ? lagane se yeh optional ho jayega
  link          String
  createdAt     DateTime @default(now())
}

// ⭐Real User Review⭐
model Review {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("ShopVibee Shopper")
  rating    Int      @default(5)
  comment   String
  ipHash    String   @unique // Yeh ensure karega ki ek hi user/device se sirf ek review aaye
  createdAt DateTime @default(now())
}